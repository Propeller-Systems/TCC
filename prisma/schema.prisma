generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model aviso {
  idaviso            Int                  @id @default(autoincrement())
  titulo             String               @db.VarChar(80)
  date               DateTime             @default(now()) @db.DateTime(0)
  conteudo           String               @db.VarChar(500)
  idusuario          Int
  escopo             aviso_escopo?
  usuario            usuario              @relation(fields: [idusuario], references: [idusuario], onDelete: NoAction, onUpdate: NoAction, map: "aviso_ibfk_1")
  aviso_destinatario aviso_destinatario[]

  @@index([idusuario], map: "fk_aviso_usuario")
}

model usuario {
  idusuario          Int                  @id @default(autoincrement())
  nome               String               @db.VarChar(45)
  email              String               @unique(map: "email_UNIQUE") @db.VarChar(45)
  dataCriacao        DateTime             @default(now()) @db.DateTime(0)
  foto               String               @db.VarChar(45)
  usuariocol         usuario_usuariocol
  senha              String               @default("h3IpM3") @db.VarChar(45)
  estado             Int                  @db.TinyInt
  aviso              aviso[]
  aviso_destinatario aviso_destinatario[]
}

model documento {
  iddocumento Int    @id @default(autoincrement())
  titulo      String @db.VarChar(255)
  texto       String @db.VarChar(500)
  caminho     String @db.VarChar(255)
}

model aviso_destinatario {
  idaviso   Int
  idusuario Int
  aviso     aviso   @relation(fields: [idaviso], references: [idaviso], onDelete: Cascade, map: "fk_destinatario_aviso")
  usuario   usuario @relation(fields: [idusuario], references: [idusuario], onDelete: Cascade, map: "fk_destinatario_usuario")

  @@id([idaviso, idusuario])
  @@index([idusuario], map: "idx_aviso_destinatario_usuario")
}

enum aviso_escopo {
  funcionario
  geral
}

enum usuario_usuariocol {
  admin
  funcionario
}
