<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TCCpricipal"
             x:Class="TCCpricipal.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Cores usadas pela aplicação -->
            <Color x:Key="OffBlack">#0B0B0B</Color>
            <Color x:Key="White">#FFFFFF</Color>
            <Color x:Key="MidnightBlue">#001F3F</Color>
            <Color x:Key="Gray600">#757575</Color>
            <Color x:Key="Gray200">#EEEEEE</Color>
            <Color x:Key="Gray950">#0A0A0A</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>







