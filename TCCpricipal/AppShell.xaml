<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TCCpricipal.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TCCpricipal"
    Title="TCCpricipal"
    FlyoutBehavior="Locked"
    Shell.NavBarIsVisible="False"
    FlyoutWidth="200"
    >

    <!-- Cabeçalho do menu lateral -->
    <Shell.FlyoutHeader>
        <!-- Ajuste: usar "*, Auto" para garantir que o botão de alternância fique em uma coluna de tamanho automático
             assim ele permanece visível mesmo quando a flyout é reduzida. -->
        <Grid Padding="5" BackgroundColor="#121212" ColumnDefinitions="*, Auto">
            <Button x:Name="ToggleFlyoutButton" Text="«" TextColor="White" FontSize="30" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" BackgroundColor="Transparent" BorderWidth="0" Padding="0" />
        </Grid>
    </Shell.FlyoutHeader>

  

    <!-- Home: TelaDeResultados será a página principal -->
    <FlyoutItem Title="Home" Icon="home.png" Route="TelaDeResultados">
        <!-- Título do ShellContent restaura a label de seleção quando necessário -->
        <ShellContent Title="Visão Geral" ContentTemplate="{DataTemplate local:TelaDeResultados}" />
    </FlyoutItem>

    <!-- Adicionar / Criar com subitens -->
    <FlyoutItem Title="Adicionar/Criar" Icon="add_box.png">
        <!-- Mantém títulos nos itens do menu lateral -->
        <ShellContent Title="Avisos" ContentTemplate="{DataTemplate local:AvisosPage}" />
        <!-- NovoUsuarioPage removida do projeto -->
        <ShellContent Title="Documentos" ContentTemplate="{DataTemplate local:DocumentosPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Calendar" Icon="calendar.png">
        <ShellContent Title="Calendário" ContentTemplate="{DataTemplate local:CalendarPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Profile" Icon="person.png">
        <ShellContent Title="Profile" ContentTemplate="{DataTemplate local:ProfilePage}" />
    </FlyoutItem>

</Shell>
