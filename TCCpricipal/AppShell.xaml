<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TCCpricipal.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TCCpricipal"
    Title="TCCpricipal"
    FlyoutBehavior="Locked"
    Shell.NavBarIsVisible="False"
    FlyoutWidth="200">

    <!-- Cabeçalho do menu lateral -->
    <Shell.FlyoutHeader>
        <Grid Padding="10" BackgroundColor="#121212" ColumnDefinitions="Auto, *">

            <Label
                Text="LOGO"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                VerticalOptions="Center" />

            <Button
                x:Name="ToggleFlyoutButton"
                Clicked="OnToggleFlyoutButtonClicked"
                Text="«"
                TextColor="White"
                FontSize="20"
                Grid.Column="1"
                HorizontalOptions="End"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                BorderWidth="0"
                Padding="0" />

        </Grid>
    </Shell.FlyoutHeader>

    <!-- Home: TelaDeResultados será a página principal -->
    <FlyoutItem Title="Home" Icon="home.png" Route="TelaDeResultados">
        <ShellContent
            Title="Visão Geral"
            ContentTemplate="{DataTemplate local:TelaDeResultados}" />
    </FlyoutItem>

    <!-- Adicionar / Criar com subitens -->
    <FlyoutItem Title="Adicionar/Criar" Icon="adicionarcriar.png">

        <ShellContent
            Title="Avisos"
            ContentTemplate="{DataTemplate local:AvisosPage}" />

        <!-- NovoUsuarioPage removida do projeto -->

        <ShellContent
            Title="Documentos"
            ContentTemplate="{DataTemplate local:DocumentosPage}" />

    </FlyoutItem>

    <FlyoutItem Title="Calendar" Icon="calendar.png">
        <ShellContent
            Title="Calendário"
            ContentTemplate="{DataTemplate local:CalendarPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Profile" Icon="profile.png">
        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate local:ProfilePage}" />
    </FlyoutItem>

</Shell>